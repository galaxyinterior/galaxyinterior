rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // RBAC HELPER FUNCTIONS
    // ---------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isCustomer() {
      return isAuthenticated() && getUserData().role == 'customer';
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isOwner(customerId) {
      return isAuthenticated() && request.auth.uid == customerId;
    }
    
    // ---------------------------------------------------------
    // USERS COLLECTION (Profiles & Roles)
    // ---------------------------------------------------------
    match /users/{userId} {
      // Users can read/write their own profile (except for role escalations)
      allow read: if isOwner(userId) || isAdmin();
      // Allow creation if user is authenticating themselves. We trust the server/admin to verify.
      // Alternatively, cloud function handles creation. For now, let user create their own doc with role='customer'
      allow create: if isOwner(userId) 
                    && request.resource.data.role == 'customer' 
                    && request.resource.data.uid == userId;
      // Allow update, but forbid changing role
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // ---------------------------------------------------------
    // INQUIRIES & CONTACT REQUESTS
    // ---------------------------------------------------------
    match /inquiries/{document=**} {
      allow create: if true 
                    && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'message', 'type', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // QUOTE REQUESTS (Customer Snapshots)
    // ---------------------------------------------------------
    match /quoteRequests/{document=**} {
      // Customer can read their own quotes
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      // Customer can create a quote request for themselves
      allow create: if isOwner(request.resource.data.customerId) || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // ---------------------------------------------------------
    // SUPPORT TICKETS & MESSAGES
    // ---------------------------------------------------------
    match /supportTickets/{ticketId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow create: if isOwner(request.resource.data.customerId) || isAdmin();
      allow update: if isOwner(resource.data.customerId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /supportMessages/{messageId} {
      // Simplified since ticket doc ID is not easily available in rules
      allow read: if isOwner(get(/databases/$(database)/documents/supportTickets/$(resource.data.ticketId)).data.customerId) || isAdmin();
      allow create: if isOwner(get(/databases/$(database)/documents/supportTickets/$(request.resource.data.ticketId)).data.customerId) || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // ---------------------------------------------------------
    // PROJECTS (Project lifecycle & Public Portfolio)
    // ---------------------------------------------------------
    match /projects/{document=**} {
      // Allow read for owner, admin, or if project is marked as public
      allow read: if isOwner(resource.data.customerId) || isAdmin() || resource.data.isPublic == true;
      // Customers can create a Draft project
      allow create: if isOwner(request.resource.data.customerId) || isAdmin();
      allow update: if isOwner(resource.data.customerId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // ---------------------------------------------------------
    // PUBLIC READ-ONLY COLLECTIONS (Managed by Admin)
    // ---------------------------------------------------------
    match /gallery_images/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /reviews/{document=**} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      // Assuming public users submit reviews that are unapproved initially
      allow create: if request.resource.data.status == 'pending' || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /pricingPackages/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pricingCategories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pricingItems/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /heroSlides/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /pageContent/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // SECURE ADMIN-ONLY COLLECTIONS
    // ---------------------------------------------------------
    match /auditLogs/{document=**} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{document=**} {
      // Customer can read their own notifications
      // Admin can read all (including those specifically directed to 'ADMIN')
      allow read: if isOwner(resource.data.userId) || (isAdmin() && resource.data.userId == 'ADMIN') || isAdmin();
      // Only admins or the system can create notifications. 
      // Actually, since customers can create tickets which trigger notifications to admins, they need create access
      allow create: if true; 
      // Customers can update (mark as read) their own, admins can update admin notifications
      allow update: if isOwner(resource.data.userId) || (isAdmin() && resource.data.userId == 'ADMIN') || isAdmin();
      allow delete: if isAdmin();
    }

    // Default fallback - closed by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
